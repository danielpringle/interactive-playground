{
  "name": "dpuk/wp-interactivity-api-playground",
  "type": "wordpress-plugin",
  "description": "Design-system tooling and theme.json utilities for block-based WordPress themes",
  "homepage": "https://danielpringle.co.uk/",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Daniel Pringle",
      "email": "dan@danielpringle.co.uk"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "wp-coding-standards/wpcs": "^3.0",
    "php-parallel-lint/php-parallel-lint": "^1.3"
  },
    "scripts": {
        "check-cs": [
            "@php ./vendor/bin/phpcs"
        ],
        "fix-cs": [
            "@php ./vendor/bin/phpcbf --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1"
        ],
        "lint": "@php ./vendor/bin/parallel-lint --exclude vendor --exclude node_modules ."
    },
  "config": {
    "vendor-dir": "./vendor",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/installers": true
    },
    "platform": {
      "php": "8.2"
    }
  }
}
